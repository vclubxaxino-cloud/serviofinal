PORT=5000
MONGO_URI=mongodb+srv://privn0612:pri%40221141@cluster0.hobms8z.mongodb.net/servio
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary — used to store KYC documents uploaded by workers.
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — used to notify customers/workers on booking & KYC status changes.
# If neither option below is set, emails are skipped (logged to console) —
# the app still works fine without email configured.

# OPTION 1 (recommended for Render/Railway) — Resend.
# Traditional SMTP (option 2 below) is often unreliable on cloud hosts —
# Gmail in particular tends to block logins from server IPs, and some
# free-tier hosts block SMTP ports entirely. Resend uses a plain HTTPS
# API call instead, so it works reliably in production. Free tier: 3000
# emails/month. Sign up at https://resend.com, verify a sending domain
# (or use their shared onboarding domain to start), then grab an API key.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Servio <no-reply@yourdomain.com>

# OPTION 2 — plain SMTP (Gmail, Brevo, SendGrid, etc). Only used if
# RESEND_API_KEY above is not set. Gmail example: use an "App Password"
# (not your normal password) — https://myaccount.google.com/apppasswords
# Note: Gmail SMTP works fine locally but is flaky when called from a
# cloud server like Render — Resend is the more reliable choice there.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Servio <your_email@gmail.com>

# Payment — Servio is UPI-only, workers never accept cash. This UPI ID is
# shown as a QR code to customers when their job is marked done.
ADMIN_UPI_ID=9992094134@ybl
ADMIN_UPI_PAYEE_NAME=Servio
